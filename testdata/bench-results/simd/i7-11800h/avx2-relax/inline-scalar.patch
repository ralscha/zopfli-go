diff --git a/relax_experiment_amd64.go b/relax_experiment_amd64.go
new file mode 100644
--- /dev/null
+++ b/relax_experiment_amd64.go
@@ -0,0 +1,52 @@
+//go:build goexperiment.simd && amd64
+
+package zopfli
+
+import "simd/archsimd"
+
+func relaxStatLengths(costs []float64, lengths []uint16, start, end int, basePlusDist float64, lengthCosts *[maxMatch + 1]float64) {
+	if end-start < 3 || !archsimd.X86.AVX2() {
+		// Keep short ranges in this function so they do not pay for a second call.
+		count := end + 1 - start
+		segment := costs[start : start+count]
+		segmentLengths := lengths[start : start+count]
+		segmentCosts := lengthCosts[start : start+count]
+		for index, current := range segment {
+			newCost := basePlusDist + segmentCosts[index]
+			if newCost < current {
+				segment[index] = newCost
+				segmentLengths[index] = uint16(start + index)
+			}
+		}
+		return
+	}
+	base := archsimd.BroadcastFloat64x4(basePlusDist)
+	for position := start; ; {
+		old := archsimd.LoadFloat64x4(costs[position : position+4])
+		candidate := base.Add(archsimd.LoadFloat64x4(lengthCosts[position : position+4]))
+		improved := candidate.Less(old)
+		if mask := improved.ToBits(); mask != 0 {
+			candidate.IfElse(improved, old).Store(costs[position : position+4])
+			if mask&1 != 0 {
+				lengths[position] = uint16(position)
+			}
+			if mask&2 != 0 {
+				lengths[position+1] = uint16(position + 1)
+			}
+			if mask&4 != 0 {
+				lengths[position+2] = uint16(position + 2)
+			}
+			if mask&8 != 0 {
+				lengths[position+3] = uint16(position + 3)
+			}
+		}
+		if position+4 == end+1 {
+			break
+		}
+		position += 4
+		if position+4 > end+1 {
+			position = end - 3
+		}
+	}
+	archsimd.ClearAVXUpperBits()
+}
diff --git a/relax_experiment_scalar.go b/relax_experiment_scalar.go
new file mode 100644
--- /dev/null
+++ b/relax_experiment_scalar.go
@@ -0,0 +1,7 @@
+//go:build !goexperiment.simd || !amd64
+
+package zopfli
+
+func relaxStatLengths(costs []float64, lengths []uint16, start, end int, basePlusDist float64, lengthCosts *[maxMatch + 1]float64) {
+	relaxStatLengthsScalar(costs, lengths, start, end, basePlusDist, lengthCosts)
+}
