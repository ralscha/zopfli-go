diff --git a/relax_experiment_amd64.go b/relax_experiment_amd64.go
new file mode 100644
--- /dev/null
+++ b/relax_experiment_amd64.go
@@ -0,0 +1,42 @@
+//go:build goexperiment.simd && amd64
+
+package zopfli
+
+import "simd/archsimd"
+
+func relaxStatLengths(costs []float64, lengths []uint16, start, end int, basePlusDist float64, lengthCosts *[maxMatch + 1]float64) {
+	if end-start < 7 || !archsimd.X86.AVX2() {
+		relaxStatLengthsScalar(costs, lengths, start, end, basePlusDist, lengthCosts)
+		return
+	}
+	base := archsimd.BroadcastFloat64x4(basePlusDist)
+	// Each 64-bit comparison lane contains either all ones or all zeroes.
+	// Select one 32-bit half per lane, then pack two sets of four into eight
+	// 16-bit masks without extracting individual results into scalar code.
+	selectLanes := archsimd.LoadUint32x8Array(&[8]uint32{0, 2, 4, 6, 0, 2, 4, 6})
+	offsets := archsimd.LoadUint16x8Array(&[8]uint16{0, 1, 2, 3, 4, 5, 6, 7})
+	for position := start; ; {
+		old0 := archsimd.LoadFloat64x4(costs[position : position+4])
+		old1 := archsimd.LoadFloat64x4(costs[position+4 : position+8])
+		candidate0 := base.Add(archsimd.LoadFloat64x4(lengthCosts[position : position+4]))
+		candidate1 := base.Add(archsimd.LoadFloat64x4(lengthCosts[position+4 : position+8]))
+		improved0 := candidate0.Less(old0)
+		improved1 := candidate1.Less(old1)
+		candidate0.IfElse(improved0, old0).Store(costs[position : position+4])
+		candidate1.IfElse(improved1, old1).Store(costs[position+4 : position+8])
+		mask0 := improved0.ToInt64x4().ToBits().ReshapeToUint32s().Permute(selectLanes).GetLo().BitsToInt32()
+		mask1 := improved1.ToInt64x4().ToBits().ReshapeToUint32s().Permute(selectLanes).GetLo().BitsToInt32()
+		mask := mask0.SaturateToInt16Concat(mask1).ToBits()
+		indices := archsimd.BroadcastUint16x8(uint16(position)).Add(offsets)
+		previous := archsimd.LoadUint16x8(lengths[position : position+8])
+		indices.And(mask).Or(previous.AndNot(mask)).Store(lengths[position : position+8])
+		if position+8 == end+1 {
+			break
+		}
+		position += 8
+		if position+8 > end+1 {
+			position = end - 7
+		}
+	}
+	archsimd.ClearAVXUpperBits()
+}
